<script>

/* PAKETLER */

const turkiyeBtn =
document.getElementById("turkiyeBtn");

const yurtDisiBtn =
document.getElementById("yurtDisiBtn");

const turkiyePackages =
document.getElementById("turkiyePackages");

const yurtDisiPackages =
document.getElementById("yurtDisiPackages");


turkiyeBtn.addEventListener("click", function() {

    turkiyeBtn.classList.add("active");

    yurtDisiBtn.classList.remove("active");

    turkiyePackages.style.display = "block";

    yurtDisiPackages.style.display = "none";

});


yurtDisiBtn.addEventListener("click", function() {

    yurtDisiBtn.classList.add("active");

    turkiyeBtn.classList.remove("active");

    turkiyePackages.style.display = "none";

    yurtDisiPackages.style.display = "block";

});


/* FAQ */

const questions =
document.querySelectorAll(".faq-question");


questions.forEach(function(question) {

    question.addEventListener("click", function() {

        const item =
        question.parentElement;

        item.classList.toggle("active");

    });

});


/* HEADER */

window.addEventListener("scroll", function() {

    const header =
    document.querySelector("header");

    if (window.scrollY > 30) {

        header.style.background =
        "rgba(5,5,5,0.96)";

    } else {

        header.style.background =
        "rgba(5,5,5,0.82)";

    }

});

</script>

